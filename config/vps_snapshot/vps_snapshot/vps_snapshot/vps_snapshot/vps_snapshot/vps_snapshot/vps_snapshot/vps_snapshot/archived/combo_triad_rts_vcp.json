{
  "name": "combo_triad_rts_vcp",
  "description": "Triad RTS VCP: Pipeline completo con patron VCP",
  "version": "1.0",
  "screener": {
    "name": "triad_rts",
    "config": "config/screeners/triad_rts.json",
    "mode": "all"
  },
  "pattern": {
    "signal_type": "vcp",
    "description": "VCP (Volatility Contraction Pattern) con validacion RTS"
  },
  "tier2_filters": {
    "min_rvol": 0.8,
    "min_adr": 1.5,
    "max_dist_sma20": 12.0,
    "min_dollar_volume": 20000000,
    "min_consolidation_days": 3,
    "min_volume": 100000,
    "min_rs_percentile": 70.0,
    "use_rs_percentile": true,
    "rs_lookback_days": 60,
    "require_spy_above_sma50": true,
    "max_vix_threshold": 25.0,
    "use_market_regime_filter": true
  },
  "tier1_optuna_space": {
    "tp1_r": {
      "min": 1.25,
      "max": 2.5,
      "step": 0.25
    },
    "tp2_r": {
      "min": 2.75,
      "max": 5.5,
      "step": 0.25
    },
    "tp1_pct": {
      "min": 0.3,
      "max": 0.5,
      "step": 0.05
    },
    "tp2_pct": {
      "min": 0.2,
      "max": 0.4,
      "step": 0.05
    }
  },
  "tier3_fixed": {
    "max_loss_pct": 1.5,
    "max_positions": 3,
    "position_size_method": "equal_weight",
    "risk_fraction": 0.005
  },
  "validation": {
    "min_win_rate": 0.4,
    "min_profit_factor": 1.2,
    "min_trades": 20
  }
}