{
  "version": "1.0",
  "description": "Configuration for sector/daily/weekly leaders in paper trading",
  "sector_leaders": {
    "method": "composite",
    "lookback_weekly": 5,
    "lookback_monthly": 20,
    "top_percentile": 0.4,
    "min_rank": 6,
    "min_rs": 0.0,
    "cache_enabled": true
  },
  "daily_leaders": {
    "top_n": 25,
    "weights": {
      "entry_score": 0.40,
      "sector_strength": 0.25,
      "rs_pct": 0.20,
      "proximity_bonus": 0.15
    },
    "use_alerts": true,
    "use_signals": true,
    "min_proximity_for_alert": 30.0
  },
  "weekly_leaders": {
    "lookback_days": 5,
    "min_appearances": 2,
    "weights": {
      "appearances": 0.35,
      "avg_score": 0.30,
      "best_rank": 0.20,
      "sector_persistence": 0.15
    },
    "sector_top_tier_required": true
  },
  "quality_gates": {
    "rs_quality_check": true,
    "rs_std_min_threshold": 15.0,
    "sector_coverage_min": 8,
    "allow_unknown_sector": true
  },
  "outputs": {
    "sector_leaders_pattern": "sector_leaders_YYYY-MM-DD.csv",
    "daily_leaders_pattern": "daily_leaders_YYYY-MM-DD.csv",
    "weekly_leaders_pattern": "weekly_leaders_YYYY-MM-DD.csv",
    "manifest_pattern": "leaders_manifest_YYYY-MM-DD.json"
  }
}