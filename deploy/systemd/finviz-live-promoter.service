[Unit]
Description=Finviz Live Promoter Service
After=network.target

[Service]
Type=simple
User=xxmalcomandaxx
WorkingDirectory=/home/xxmalcomandaxx/swing-momentum-v1
ExecStart=/home/xxmalcomandaxx/swing-momentum-v1/run_vps_job.sh scripts/finviz_live_promoter.py --monitor --interval 1 --telegram
Restart=always
StandardOutput=append:/home/xxmalcomandaxx/swing-momentum-v1/logs/finviz_live_promoter.log
StandardError=append:/home/xxmalcomandaxx/swing-momentum-v1/logs/finviz_live_promoter.log

[Install]
WantedBy=multi-user.target
