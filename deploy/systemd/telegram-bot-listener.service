[Unit]
Description=Momentum V2 Telegram Bot Listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/momentum-v2
EnvironmentFile=/opt/momentum-v2/.env
ExecStart=/usr/bin/env bash /opt/momentum-v2/scripts/run_telegram_listener.sh
Restart=always
RestartSec=5
StandardOutput=append:/opt/momentum-v2/logs/telegram_bot_listener.log
StandardError=append:/opt/momentum-v2/logs/telegram_bot_listener.log

[Install]
WantedBy=multi-user.target
