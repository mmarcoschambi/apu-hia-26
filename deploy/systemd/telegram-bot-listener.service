[Unit]
Description=Momentum V2 Telegram Bot Listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/xxmalcomandaxx/swing-momentum-v1
EnvironmentFile=/home/xxmalcomandaxx/swing-momentum-v1/.env
ExecStart=/usr/bin/env bash /home/xxmalcomandaxx/swing-momentum-v1/scripts/run_telegram_listener.sh
Restart=always
RestartSec=5
StandardOutput=append:/home/xxmalcomandaxx/swing-momentum-v1/logs/telegram_bot_listener.log
StandardError=append:/home/xxmalcomandaxx/swing-momentum-v1/logs/telegram_bot_listener.log

[Install]
WantedBy=multi-user.target
