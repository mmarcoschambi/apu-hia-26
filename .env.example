# ==============================================================================
# VARIABLES DE ENTORNO DEL PROYECTO PMA-DOCKER 2026 (HIA - UNJu)
# ==============================================================================
# Copia este archivo como '.env' para tu entorno de ejecución local.
# NUNCA agregues valores de producción reales a este archivo versionado en Git.

# --- MYSQL DATABASE CONFIGURATION ---
MYSQL_ROOT_PASSWORD=secret_root_password_change_me
MYSQL_DATABASE=pmai_db
MYSQL_USER=pmai_app
MYSQL_PASSWORD=pmai_app_secure_password

# --- N8N WORKFLOW AUTOMATION CONFIGURATION ---
N8N_ENCRYPTION_KEY=super_secret_n8n_encryption_key_32bytes
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost/
GENERIC_TIMEZONE=America/Argentina/Jujuy
TZ=America/Argentina/Jujuy

# --- NGINX GATEWAY CONFIGURATION ---
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
