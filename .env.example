# ==============================================================================
# VARIABLES DE ENTORNO DEL PROYECTO PMA-DOCKER 2026 (HIA - UNJu)
# ==============================================================================
# Copia este archivo como '.env' para tu entorno de ejecución local.
# NUNCA agregues valores de producción reales a este archivo versionado en Git.

# --- MYSQL DATABASE CONFIGURATION ---
MYSQL_ROOT_PASSWORD=secret_root_password_change_me
MYSQL_DATABASE=pmai_db
MYSQL_USER=pmai_app
MYSQL_PASSWORD=pmai_app_secure_password

# --- N8N WORKFLOW AUTOMATION CONFIGURATION ---
N8N_ENCRYPTION_KEY=super_secret_n8n_encryption_key_32bytes
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost/
GENERIC_TIMEZONE=America/Argentina/Jujuy
TZ=America/Argentina/Jujuy

# US-11: Imagen custom publicada en GHCR (fallback al upstream oficial si está vacía)
N8N_IMAGE=ghcr.io/mmarcoschambi/apu-hia-26/n8n-pmai:latest

# --- NGINX GATEWAY CONFIGURATION ---
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# ==============================================================================
# US-06: CONFIGURACIÓN DE RESPALDOS LÓGICOS DE MYSQL
# ==============================================================================
# Frecuencia del ciclo de backup (en horas)
BACKUP_INTERVAL_HOURS=24
# Retención: cantidad de días que se conservan los archivos .sql.gz
BACKUP_RETENTION_DAYS=7
# Bandera para CI/tests: si es 'true' ejecuta un único dump y termina
BACKUP_RUN_ONCE=false

# ==============================================================================
# US-09: CONFIGURACIÓN DE ALERTAS SMTP PARA WORKFLOWS
# ==============================================================================
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=
N8N_SMTP_PASS=
N8N_SMTP_SENDER=n8n-alerts@apu-hia-26.local
N8N_SMTP_SSL=false
N8N_SMTP_STARTTLS=true

# ==============================================================================
# US-12: CONFIGURACIÓN DE DEPLOY A PRODUCCIÓN (no se exporta al runtime)
# ==============================================================================
# Estas variables son consumidas por el workflow deploy-production.yml
# y NO se inyectan a los contenedores. Configurarlas como GitHub Secrets.
# DEPLOY_HOST=deploy@tu-servidor.example.com
# DEPLOY_SSH_KEY=
# DEPLOY_PATH=/srv/apu-hia-26
# DEPLOY_HEALTH_URL=https://tu-dominio/healthz
