ticker_cache = TickerCache()

# Función para cargar/guardar watchlist
WATCHLIST_FILE = 'config/watchlist.json'

def load_watchlist_json():
    if os.path.exists(WATCHLIST_FILE):
        with open(WATCHLIST_FILE, 'r') as f:
            return json.load(f)
    return {}

def save_watchlist_json(data):
    with open(WATCHLIST_FILE, 'w') as f:
        json.dump(data, f, indent=4)

def get_cache_date_range():
    """
    Obtiene el rango de fechas real disponible en el cache (tanto .pkl como SQLite)
    Returns: (min_date, max_date) as datetime objects
    """
    min_date = None
    max_date = None
    
    # 1. Check SQLite Cache
    try:
        cursor = ticker_cache.conn.execute("SELECT MIN(date), MAX(date) FROM ohlcv_cache")
        sqlite_min, sqlite_max = cursor.fetchone()
        if sqlite_min and sqlite_max:
            min_date = datetime.strptime(sqlite_min, '%Y-%m-%d')
            max_date = datetime.strptime(sqlite_max, '%Y-%m-%d')
    except Exception as e:
        pass

    # 2. Check Legacy .pkl Cache
    cache_dir = 'data/cache'
    if os.path.exists(cache_dir):
        try:
            for file in os.listdir(cache_dir):
                # Only process daily data files
                if file.endswith('_daily.pkl'):
                    try:
                        with open(os.path.join(cache_dir, file), 'rb') as f:
                            data = pickle.load(f)
                            if not data.empty:
                                file_min = data.index.min()
                                file_max = data.index.max()
                                
                                if hasattr(file_min, 'to_pydatetime'):
                                    file_min = file_min.to_pydatetime()
                                if hasattr(file_max, 'to_pydatetime'):
                                    file_max = file_max.to_pydatetime()

                                if min_date is None or file_min < min_date:
                                    min_date = file_min
                                if max_date is None or file_max > max_date:
                                    max_date = file_max
                    except:
                        continue
        except:
            pass
    
    # Default fallback if nothing found
    if min_date is None or max_date is None:
        return datetime(2020, 1, 1), datetime.now()
    
    # Cap max_date to today (no future dates)
    today = datetime.now()
    if max_date > today:
        max_date = today
    
    return min_date, max_date

def get_educational_insight(trade):
    """Genera una explicación educativa dinámica basada en el contexto del trade"""
    insights = []
    
    # 1. Contexto de Mercado (El Clima)
    regime = trade.get('market_regime', 'UNKNOWN') # BULLISH, SAFE, DANGER
    vix = trade.get('vix_at_entry', 0)
    
    if regime == 'BULLISH':
        insights.append(f"🟢 **Entorno de Mercado (Luz Verde):**\n"
                        f"El mercado estaba fuerte (**BULLISH**). Con el VIX bajo ({vix:.1f}) y SPY en tendencia, "
                        f"el sistema operó en modo agresivo: Stops más holgados (1.5x ATR) para aguantar la volatilidad "
                        f"normal y Exposición máxima permitida.")
    elif regime == 'SAFE':
        insights.append(f"🟡 **Entorno de Mercado (Precaución):**\n"
                        f"El mercado estaba **NEUTRAL** ('SAFE'). No había pánico, pero tampoco euforia. "
                        f"El sistema redujo la exposición un 25% para proteger capital ante la incertidumbre.")
    elif regime == 'DANGER':
        insights.append(f"🔴 **Entorno de Mercado (Tormenta):**\n"
                        f"El mercado estaba en modo **DANGER**. Probablemente el VIX estaba alto (>20) o el SPY bajo su media. "
                        f"El sistema activó 'Protocolo de Emergencia': Stops muy ajustados (1.0x ATR) y posiciones reducidas a la mitad.")

    # 2. Contexto Sectorial (El Viento)
    sector = trade.get('sector', 'Unknown')
    strength = trade.get('sector_strength', 0)
    
    if strength > 15:
        insights.append(f"🚀 **Viento a Favor (Sector):**\n"
                        f"El sector **{sector}** era uno de los líderes del mercado (RS: {strength:.1f}). "
                        f"Regla de Oro: 'Comprar las acciones más fuertes de los sectores más fuertes'.")
    elif strength > 0:
         insights.append(f"✅ **Sector Saludable:**\n"
                        f"El sector **{sector}** acompañaba al mercado (RS: {strength:.1f}). Un buen entorno para buscar oportunidades.")
    elif strength < 0:
        insights.append(f"⚠️ **Viento en Contra (Sector):**\n"
                        f"Atención: Compramos **{sector}** aunque mostraba debilidad relativa (RS: {strength:.1f}). "
                        f"Esto requiere un setup técnico perfecto para compensar la falta de apoyo institucional del sector.")

    # 3. Gestión de la Salida (La Defensa)
    exit_reason = trade.get('reason', trade.get('exit_phase', 'Unknown'))
    adr = trade.get('context_adr', 0)
    
    if 'EMA10' in str(exit_reason):
        insights.append(f"🛡️ **Por qué salimos (EMA10):**\n"
                        f"La acción perdió su media móvil rápida (EMA10). Al ser una acción volátil (ADR {adr:.1f}%) "
                        f"o estar en un mercado difícil, aplicamos la regla: 'Si parpadea, vendemos'. No damos espacio a que las ganancias se evaporen.")
    elif 'SMA20' in str(exit_reason):
        insights.append(f"📉 **Por qué salimos (SMA20):**\n"
                        f"El precio cerró por debajo de la SMA20. Esta línea es el 'guardarraíl' de las tendencias a corto plazo. "
                        f"Si se rompe, la inercia alcista suele haberse perdido.")
    elif 'SMA50' in str(exit_reason):
        insights.append(f"🛑 **Por qué salimos (SMA50):**\n"
                        f"Se rompió la SMA50. Para posiciones de estilo inversión, esto indica un cambio de carácter mayor en la tendencia. Hora de salir.")
    elif 'STOP' in str(exit_reason):
        insights.append(f"🚫 **Stop Loss Ejecutado:**\n"
                        f"El precio tocó nuestro nivel de invalidación. ¡Esto es bueno! Perder pequeño es parte del negocio. "
                        f"Protegimos el capital para la siguiente oportunidad.")
        
    return insights

# Función para ejecutar backtest con VectorBT (NUEVO - RÁPIDO)
def run_vectorbt_backtest_ui(start_date, end_date, equity: float = 100000, risk_pct: float = 0.5, max_exp_pct: float = 25,
                             tickers_list=None, max_symbols=0, risk_dollars=None,
                             # Filter parameters
                             max_dist_sma20=7.0, rvol_danger=3.0, rvol_warning=2.0,
                             rvol_danger_size=25, rvol_warning_size=60,
                              adr_high=6.0, adr_med=5.0, max_stop_pct=8.0,
                              earnings_days=5, earnings_cushion=10.0,
                              # New dynamic parameters
                              min_rvol=1.0, min_adr=1.0, min_volume=300000, min_dollar_volume=15000000,
                              # Market Regime parameters
                              use_market_regime_filter=False, block_trades_in_stage3=True,
                              block_trades_in_stage4=True, adjust_risk_by_regime=True,
                              # Professional filters (NEW!)
                              require_spy_above_sma50=True,  # SPY > SMA50 required
                              min_consolidation_days=10,  # VCP quality (10+ days):
    
    Args:
        max_symbols: 0 = usar TODOS los tickers con datos disponibles (recomendado con vectorbt)
                     >0 = limitar a top N por liquidez (legacy, no necesario)
        max_dist_sma20: Maximum % above SMA20 to allow entry (default 7%
        rvol_danger: RVOL threshold for Danger classification (default 3x
        rvol_warning: RVOL threshold for Warning classification (default 2x
        rvol_danger_size: Size % when Danger (default 25% = 75% reduction)
        rvol_warning_size: Size % when Warning (default 60% = 40% reduction)
        adr_high: ADR threshold for high volatility size reduction (default 6%
        adr_med: ADR threshold for medium volatility size reduction (default 5%
        max_stop_pct: Maximum stop loss % (default 8%
        earnings_days: Days before earnings to reduce size (default 5)
        earnings_cushion: Minimum profit % to hold through earnings (default 10%
    """
    progress_bar = st.progress(0)
    status_text = st.empty()
    
    status_text.markdown("🚀 **Ejecutando con VectorBT Engine** (ultra-rápido)...")
    progress_bar.progress(0.1)
    
    import time
    start_time = time.time()
    
    try:
        from src.backtest.vectorbt_engine_advanced import AdvancedVectorBTEngine
        
        # Build universe
        if tickers_list and len(tickers_list) > 0:
            universe = tickers_list
        else:
            # Get all tickers with sufficient data in the period
            import sqlite3
            from datetime import datetime, timedelta
            
            conn = sqlite3.connect('./data/ticker_cache.db')
            
            selection_start = str(start_date)
            selection_end = str(end_date)
            date_range_days = (end_date - start_date).days
            
            # Calcular días mínimos requeridos (al menos 40% de cobertura para rangos largos)
            expected_trading_days = int(date_range_days * 0.7)  # ~70% de días calendario son trading days
            min_required_days = max(100, int(expected_trading_days * 0.4))  # 40% mínimo
            
            # Decidir si usar todos los tickers o limitar por liquidez
            if max_symbols == 0:
                # MODO COMPLETO: Usar TODOS los tickers con datos suficientes
                status_text.markdown(f"🔍 **Modo Universo Completo** - usando todos los tickers disponibles...")
                query = """
                SELECT ticker
                FROM ohlcv_cache
                WHERE date BETWEEN ? AND ?
                GROUP BY ticker
                HAVING COUNT(*) >= ?
                ORDER BY ticker
                """
                cursor = conn.execute(query, (selection_start, selection_end, min_required_days))
            else:
                # MODO LIMITADO: Top N por liquidez (legacy)
                status_text.markdown(f"🔍 **Modo Limitado** - top {max_symbols} por liquidez...")
                query = """
                SELECT ticker, AVG(dollar_volume) as avg_dv
                FROM ohlcv_cache
                WHERE date BETWEEN ? AND ?
                AND dollar_volume IS NOT NULL
                GROUP BY ticker
                HAVING COUNT(*) >= ?
                ORDER BY avg_dv DESC
                LIMIT ?
                """
                cursor = conn.execute(query, (selection_start, selection_end, min_required_days, max_symbols))
            
            universe = [row[0] for row in cursor.fetchall()]
            conn.close()
            
            status_text.caption(f"📊 Requiriendo mínimo {min_required_days} días (~{int(min_required_days/expected_trading_days*100)}% cobertura)")
            
            if not universe:
                raise ValueError(f"No se encontraron tickers con al menos {min_required_days} días de datos entre {selection_start} y {selection_end}.")
            
            # Mostrar info del universo
            status_text.success(f"✅ Universo cargado: {len(universe)} tickers")
            if len(universe) > 0:
                status_text.caption(f"Primeros 5 tickers: {', '.join(universe[:5])}")
        
        status_text.markdown(f"📊 **Cargando datos** para {len(universe)} tickers...")
        status_text.caption(f"📅 Periodo del backtest: {start_date} a {end_date}")
        progress_bar.progress(0.3)
        
        # Run backtest
        engine = AdvancedVectorBTEngine(
            universe=universe,
            start_date=str(start_date),
            end_date=str(end_date),
            initial_capital=equity,
            risk_pct=risk_pct / 100.0,
            risk_dollars=risk_dollars,  # NEW: Fixed dollar risk parameter
            max_exposure_pct=max_exp_pct / 100.0,
            # Filter parameters
            max_dist_sma20=max_dist_sma20,
            min_rvol=min_rvol,          # DYNAMIC
            min_adr=min_adr,            # DYNAMIC
            min_volume=min_volume,      # DYNAMIC
            min_dollar_volume=min_dollar_volume, # DYNAMIC
            rvol_danger=rvol_danger,
            rvol_warning=rvol_warning,
            rvol_danger_size=rvol_danger_size,
            rvol_warning_size=rvol_warning_size,
            adr_high=adr_high,
            adr_med=adr_med,
            max_stop_pct=max_stop_pct,
            earnings_days=earnings_days,
            earnings_cushion=earnings_cushion,
            # Market Regime Filter (NEW!)
            use_market_regime_filter=use_market_regime_filter,
            block_trades_in_stage3=block_trades_in_stage3,
            block_trades_in_stage4=block_trades_in_stage4,
            adjust_risk_by_regime=adjust_risk_by_regime,
             # Dynamic Thresholds (NEW!)
             use_dynamic_thresholds=use_dynamic_thresholds,
             max_vix_threshold=max_vix_threshold,
             # Professional filters (NEW!)
             require_spy_above_sma50=True,  # SPY > SMA50 required
             min_consolidation_days=10,  # VCP quality (10+ days)
         )
        
        progress_bar.progress(0.5)
        status_text.markdown(f"⚡ **Ejecutando backtest vectorizado**...")
        
        filter_msg = f"""🎛️ **Filtros activos:**
- dist_sma20 < {max_dist_sma20}%
- VolTrig: Danger≥{rvol_danger}x→{rvol_danger_size}%, Warning≥{rvol_warning}x→{rvol_warning_size}%, Safe→100%
- ADR: High={adr_high}%, Med={adr_med}%
- Stop cap: {max_stop_pct}%
- Earnings: {earnings_days}d window, {earnings_cushion}% cushion"""

        if use_dynamic_thresholds:
            filter_msg += f"\n\n📊 **Umbrales Dinámicos (VIX):**\n- Min RVOL/ADR ajustados por volatilidad\n- SPY > SMA50 requerido\n- Max VIX: {max_vix_threshold}"

        if use_market_regime_filter:
            filter_msg += f"\n- 🌍 Market Regime: Stage 3 Block={block_trades_in_stage3}, Stage 4 Block={block_trades_in_stage4}, Adjust Risk={adjust_risk_by_regime}"
        
        status_text.caption(filter_msg)
        
        results = engine.run_backtest()
        engine.cleanup()
        
        progress_bar.progress(0.9)
        
        # Save results in compatible format
        trades = results['trades']
        if len(trades) > 0:
            # Convert to format expected by dashboard
            # Note: AdvancedVectorBTEngine renames 'ticker'->'symbol', 'entry_signal'->'signal_type', 'exit_phase'->'trade_type'
            output_df = pd.DataFrame({
                'symbol': trades['symbol'],
                'entry_date': pd.to_datetime(trades['entry_date']),
                'exit_date': pd.to_datetime(trades['exit_date']),
                'entry_price': trades['entry_price'],
                'exit_price': trades['exit_price'],
                'shares': trades['shares'],
                'pnl': trades['pnl'],
                'signal_type': trades['signal_type'],
                'exit_phase': trades['trade_type'],
                'bars_held': (pd.to_datetime(trades['exit_date']) - pd.to_datetime(trades['entry_date'])).dt.days,
                # Context data
                'context_adr': trades['context_adr'],
                'context_rvol': trades['context_rvol'],
                'context_trend': trades['context_trend'],
                'context_vol': trades['context_vol'],
                'context_dollar_vol': trades['context_dollar_vol'],
                # Market Regime Data
                'spx_vs_voltrig': trades.get('spx_vs_voltrig', False),
                'spy_at_entry': trades.get('spy_at_entry', 0.0),
                'vix_at_entry': trades.get('vix_at_entry', 0.0),
                'spy_ema20_at_entry': trades.get('spy_ema20_at_entry', 0.0),
                
                # Hidden/Quality Columns
                'time_since_earnings': trades.get('time_since_earnings', -1),
                'sector_strength': trades.get('sector_strength', 0.0),
                'dist_sma20_pct': trades.get('dist_sma20_pct', 0.0),
                'consolidation_days': trades.get('consolidation_days', 0),
                'is_vcp_pattern': trades.get('is_vcp_pattern', False),
                # Position Sizing
                'adjusted_risk_dollars': trades.get('adjusted_risk_dollars', 0.0),
                'base_risk_dollars': trades.get('base_risk_dollars', 0.0)
            })
            
            # Save main results
            output_df.to_csv('outputs/backtests/backtest_results.csv', index=False)
            
            # Save equity curve
            results['equity_curve'].to_csv('outputs/backtests/equity_curve.csv')
            
            # ✅ NUEVO: Save complete trade log for QuantStats (with ALL columns)
            # This includes all context fields, position sizing details, etc.
            trades_df_full = trades.copy()
            
            # Rename columns to match QuantStats expectations
            column_mapping = {
                'symbol': 'ticker',           # QuantStats expects 'ticker'
                'trade_type': 'exit_phase',   # QuantStats expects 'exit_phase'
                'signal_type': 'entry_signal' # QuantStats expects 'entry_signal'
            }
            
            # Only rename if columns exist
            for old_col, new_col in column_mapping.items():
                if old_col in trades_df_full.columns and new_col not in trades_df_full.columns:
                    trades_df_full.rename(columns={old_col: new_col}, inplace=True)
            
            # Ensure ticker column exists (fallback)
            if 'ticker' not in trades_df_full.columns and 'symbol' in trades_df_full.columns:
                trades_df_full['ticker'] = trades_df_full['symbol']
            
            # Save complete trade log with all columns
            trades_df_full.to_csv('outputs/backtests/trade_log.csv', index=False)
            
            # Generar tabla de salidas parciales (para compatibilidad con visualización)
            # Cada trade del motor VectorBT ya tiene 'exit_phase' (TP1, TP2, STOP)
            partial_exits_df = output_df.copy()

            # Agregar columnas que espera la UI pero no genera VectorBT
            partial_exits_df['phase'] = partial_exits_df['exit_phase']  # Renombrar
            partial_exits_df['return_pct'] = ((partial_exits_df['exit_price'] - partial_exits_df['entry_price']) / partial_exits_df['entry_price']) * 100

            # Calcular porcentaje vendido basado en shares vendidas vs shares iniciales
            # Usar initial_shares si está disponible, sino usar shares originales
            if 'initial_shares' in partial_exits_df.columns:
                partial_exits_df['exit_pct'] = (partial_exits_df['shares'] / partial_exits_df['initial_shares'] * 100).fillna(100.0)
            else:
                # Si no hay initial_shares, usar un valor estimado basado en la fase
                # Primero mapear valores básicos
                partial_exits_df['exit_pct'] = partial_exits_df['exit_phase'].map({
                    'TP1': 40.0,  # TP1 vende ~40%
                    'TP2': 30.0,  # TP2 vende ~30%
                    'STOP': 100.0,  # STOP vende 100% (si no se alcanzó TP1/TP2)
                    'STOP_BE': 100.0,  # STOP en breakeven vende 100% restante
                    'RUNNER_STOP': 30.0  # RUNNER_STOP vende el 30% restante
                }).fillna(100.0)

                # Ajustar para fases específicas de runner
                runner_mask = partial_exits_df['exit_phase'].str.contains('PHASE3_', na=False)
                partial_exits_df.loc[runner_mask, 'exit_pct'] = 30.0  # Fase 3 vende ~30% restante

            partial_exits_df['reason'] = partial_exits_df['exit_phase'].map({
                'TP1': 'TP1: Take Profit 1 (+1.5R)',
                'TP2': 'TP2: Take Profit 2 (+3R)',
                'STOP': 'STOP: Stop Loss',
                'STOP_BE': 'STOP: Stop Loss (Breakeven)',
                'RUNNER_STOP': 'RUNNER: Trailing Stop Exit',
                'PHASE3_SMA50_BREAK': 'PHASE3: SMA50 Break Exit'
            }).fillna('UNKNOWN')
            
            partial_exits_df.to_csv('outputs/backtests/partial_exits.csv', index=False)
        
        elapsed = time.time() - start_time
        
        progress_bar.progress(1.0)
        status_text.success(f"✅ **Completado en {elapsed:.1f}s** | Return: {results['total_return']*100:+.2f}% | Trades: {results['total_trades']}")
        
        st.balloons()
        
        # Recargar la app para mostrar los resultados nuevos (sin delay)
        st.rerun()
        
        # System notification
        try:
            import shutil
            if shutil.which("powershell.exe"):
                ps_cmd = "[reflection.assembly]::loadwithpartialname('System.Windows.Forms'); $notify = new-object system.windows.forms.notifyicon; $notify.icon = [System.Drawing.SystemIcons]::Information; $notify.visible = $true; $notify.showballoontip(10, 'Momentum V2', '⚡ VectorBT Backtest Finalizado', [system.windows.forms.tooltipicon]::None)"
                subprocess.run(['powershell.exe', '-Command', ps_cmd], check=False, capture_output=True)
        except:
            pass
        
        return True
        
    except Exception as e:
        status_text.error(f"❌ Error: {str(e)}")
        import traceback
        st.code(traceback.format_exc())
        return False

# Función para ejecutar el backtest con UI de progreso y parámetros de riesgo (MOTOR ORIGINAL)
def run_backtest_with_progress(start_date, end_date, stop_loss_pct=None, 
                               equity: float = 100000, risk_pct: float = 0.5, max_exp_pct: float = 25,
                               min_mcap_b=2.0, max_mcap_b=20.0, 
                               min_vol_k=300, min_adr=1.5, min_price=5.0, min_dollar_m=15,
                               min_rvol=1.5, watchlist_path='config/watchlist.json', skip_filters=False,
                               source='file', sector=None, offline=False, max_symbols=None, sort_by='liquidity'):
    progress_bar = st.progress(0)
    status_text = st.empty()
    log_area = st.empty()
    logs = []

    cmd = [
        "python3", "daily_backtest_runner.py",
        "--start", str(start_date),
        "--end", str(end_date),
        "--watchlist", watchlist_path,
        "--equity", str(equity),
        "--risk", str(risk_pct / 100.0),
        "--max_exp", str(max_exp_pct / 100.0),
        "--min_mcap", str(min_mcap_b * 1e9),
        "--max_mcap", str(max_mcap_b * 1e9),
        "--min_volume", str(int(min_vol_k * 1000)),
        "--min_adr", str(min_adr),
        "--min_price", str(min_price),
        "--min_dollar_vol", str(int(min_dollar_m * 1e6)),
        "--min_rvol", str(min_rvol),
        "--source", str(source)
    ]
    
    if sector:
        cmd.extend(["--sector", str(sector)])
    
    if offline:
        cmd.append("--offline")
    
    if skip_filters:
        cmd.append("--skip_filters")
    
    if stop_loss_pct is not None and stop_loss_pct > 0:
        cmd.extend(["--stop_loss", str(stop_loss_pct)])
    
    if max_symbols:
        cmd.extend(["--max_symbols", str(max_symbols)])
    
    if sort_by:
        cmd.extend(["--sort_by", str(sort_by)])
    
    try:
        process = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            universal_newlines=True
        )
        
        while True:
            line = process.stdout.readline()
            if not line and process.poll() is not None:
                break
            if line:
                line = line.strip()
                if "__PROGRESS__" in line:
                    parts = line.split("__")
                    if len(parts) >= 3:
                        progress_info = parts[2].split("/") # "1/10"
                        info_text = parts[3] if len(parts) > 3 else ""
                        
                        if len(progress_info) == 2:
                            try:
                                current = int(progress_info[0])
                                total = int(progress_info[1])
                                progress = min(1.0, max(0.0, float(current) / float(total)))
                                progress_bar.progress(progress)
                                
                                # Detectar fase basado en el texto
                                if "Loading" in info_text:
                                    status_text.markdown(f"📥 **Descargando/Verificando Datos**... \n\n`{info_text}` ({current}/{total})")
                                else:
                                    status_text.markdown(f"🔄 **Simulando Mercado**... \n\n`{info_text}` ({current}/{total} días)")
                            except:
                                pass
                else:
                    logs.append(line)
                    log_text = "\n".join(logs[-10:])
                    log_area.code(log_text)
        
        if process.returncode == 0:
            progress_bar.progress(1.0)
            status_text.success("✅ Backtest completado exitosamente!")
            st.toast("🚀 ¡Proceso Terminado!", icon="✅")
            st.balloons()
            
            # System Notification (Linux / WSL2 Windows)
            try:
                # 1. Try Windows Notification via PowerShell (WSL2)
                import shutil
                if shutil.which("powershell.exe"):
                    ps_cmd = "[reflection.assembly]::loadwithpartialname('System.Windows.Forms'); [reflection.assembly]::loadwithpartialname('System.Drawing'); $notify = new-object system.windows.forms.notifyicon; $notify.icon = [System.Drawing.SystemIcons]::Information; $notify.visible = $true; $notify.showballoontip(10, 'Momentum V2', '🚀 Backtest Finalizado Exitosamente', [system.windows.forms.tooltipicon]::None)"
                    subprocess.run(['powershell.exe', '-Command', ps_cmd], check=False)
                
                # 2. Try Linux native notification (fallback or for Linux users)
                if shutil.which("notify-send"):
                    subprocess.run(['notify-send', '-u', 'normal', '-t', '5000', 'Momentum V2', '🚀 Backtest Finalizado Exitosamente'], check=False)
            except Exception:
                pass
                
            time.sleep(1)
            st.cache_data.clear()
            return True
        else:
            status_text.error("❌ Error en la ejecución.")
            return False

    except Exception as e:
        status_text.error(f"Error inesperado: {e}")
        return False

