# --- Carga de datos (SIN CACHE para actualizaciones inmediatas) ---
def load_data():
    """Carga los resultados del backtest más reciente"""
    try:
        main_df = pd.DataFrame()
        partial_df = pd.DataFrame()
        
        if os.path.exists('outputs/backtests/backtest_results.csv'):
            main_df = pd.read_csv('outputs/backtests/backtest_results.csv')
            main_df['entry_date'] = pd.to_datetime(main_df['entry_date'])
            main_df['exit_date'] = pd.to_datetime(main_df['exit_date'])
            main_df['trade_type'] = 'FULL_EXIT'  # Marcar como cierre completo
            
            # Calcular exit_price si no existe (compatibilidad con backtests viejos)
            if 'exit_price' not in main_df.columns:
                if 'pnl' in main_df.columns and 'entry_price' in main_df.columns and 'shares' in main_df.columns:
                    main_df['exit_price'] = main_df['entry_price'] + (main_df['pnl'] / main_df['shares'])
                else:
                    main_df['exit_price'] = main_df['entry_price']  # Fallback
            
            # Calcular columnas derivadas si no existen
            if 'returns_pct' not in main_df.columns:
                main_df['returns_pct'] = ((main_df['exit_price'] - main_df['entry_price']) / main_df['entry_price']) * 100
            
            if 'is_profitable' not in main_df.columns:
                main_df['is_profitable'] = main_df['pnl'] > 0
            
            if 'monetary_risk' not in main_df.columns:
                # Calcular riesgo monetario (asumiendo stop loss 5% por debajo del entry)
                main_df['monetary_risk'] = main_df['entry_price'] * 0.05 * main_df['shares']
            
            if 'position_value' not in main_df.columns:
                # Valor de la posición al momento de entrada
                main_df['position_value'] = main_df['entry_price'] * main_df['shares']
        
        # Cargar salidas parciales si existen
        if os.path.exists('outputs/backtests/partial_exits.csv'):
            partial_df = pd.read_csv('outputs/backtests/partial_exits.csv')
            partial_df['entry_date'] = pd.to_datetime(partial_df['entry_date'])
            partial_df['exit_date'] = pd.to_datetime(partial_df['exit_date'])
            partial_df['trade_type'] = partial_df['phase']  # FASE_1 o FASE_2
            
            # Renombrar columnas para compatibilidad con main_df
            partial_df = partial_df.rename(columns={
                'shares_sold': 'shares',
                'pct_sold': 'exit_pct'
            })
        
        return main_df, partial_df
    except Exception as e:
        st.error(f"Error cargando datos: {e}")
        return pd.DataFrame(), pd.DataFrame()

# Cargar datos (sin cache - actualización inmediata)
df_raw, df_partial_raw = load_data()

