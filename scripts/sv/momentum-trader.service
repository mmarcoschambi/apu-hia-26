[Unit]
Description=Momentum Trader Service
Documentation=https://github.com/malcolmmm/momentum-v2
After=network.target
Wants=momentum-telegram.service

[Service]
Type=simple
User=momentum
Group=momentum
WorkingDirectory=/home/marcos/trade/momentum-v2
EnvironmentFile=/home/marcos/trade/momentum-v2/.env
ExecStart=/home/marcos/trade/momentum-v2/start_live_session.sh --headless
Restart=always
RestartSec=10
PIDFile=/home/marcos/trade/momentum-v2/run/momentum-trader.pid
StandardOutput=append:/home/marcos/trade/momentum-v2/logs/live/auto_trader.log
StandardError=append:/home/marcos/trade/momentum-v2/logs/live/auto_trader.log

[Install]
WantedBy=multi-user.target
